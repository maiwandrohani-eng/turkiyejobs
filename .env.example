# Database (Neon) — use the *pooled* connection string on Vercel/serverless:
# postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Run once after creating the DB: npx prisma db push  (or prisma migrate deploy)
DATABASE_URL=""

# NextAuth (set strong secret in production; Vercel: 32+ random bytes)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Public site URL — must match your Vercel Production domain (www if apex redirects to www)
NEXT_PUBLIC_SITE_URL="https://www.turkiyejobs.org"

# Only "true" for local preview / UX testing — keep false in production
NEXT_PUBLIC_ENABLE_DEMO_AUTH="false"

# Transactional email (Resend — https://resend.com). RESEND_API_KEY required to send.
# RESEND_API_KEY=""
# Default from-address if unset: TürkiyeJobs <noreply@turkiyejobs.org>
# EMAIL_FROM="TürkiyeJobs <noreply@turkiyejobs.org>"
# TODO: configure Resend domain + DNS for turkiyejobs.org before production send
# Contact form: receives copies of /contact submissions (must be a real inbox you monitor).
# CONTACT_INBOX_EMAIL="maiwandr@gmail.com"
