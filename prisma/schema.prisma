generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  role                UserRole             @default(INDIVIDUAL)
  firstName           String?
  lastName            String?
  phone               String?
  location            String?
  bio                 String?
  cvFileName          String?
  cvFileUrl           String?
  linkedinUrl         String?
  portfolioUrl        String?
  organizationId      String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  auditActions        AdminActionLog[]     @relation("AdminActor")
  applications        Application[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  saved               SavedOpportunity[]
  claimRequests       OrganizationClaimRequest[]
  organization        Organization?        @relation(fields: [organizationId], references: [id])

  @@index([role])
  @@index([organizationId])
}

model Organization {
  id                  String                      @id @default(cuid())
  name                String
  slug                String                      @unique
  email               String?
  phone               String?
  website             String?
  location            String?
  description         String?
  logoUrl             String?
  featuredBadge       Boolean                     @default(false)
  profileCompleteness Int                         @default(0)
  verificationStatus  OrgVerificationStatus       @default(PENDING)
  verifiedAt          DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  /// * When false, the org is hidden from the public directory and cannot post.
  isActive            Boolean                     @default(true)
  abbreviation        String?
  organizationType    String?
  sourceType          String?
  country             String?
  platform            String?
  sourceUrl           String?
  claimed             Boolean                     @default(false)
  importedAt          DateTime?
  importedBy          String?
  notifications       Notification[]
  opportunities       Opportunity[]
  profileChanges      OrganizationProfileChange[]
  claimRequests       OrganizationClaimRequest[]
  users               User[]
}

model OrganizationClaimRequest {
  id             String             @id @default(cuid())
  organizationId String
  requesterUserId String
  requesterEmail String
  requesterName  String?
  message        String?
  status         OrgClaimRequestStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User         @relation(fields: [requesterUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([requesterUserId, status, createdAt])
}

/// * Employer-proposed organization directory / contact updates; applied after admin approval.
model OrganizationProfileChange {
  id                  String                 @id @default(cuid())
  organizationId      String
  status              OrgProfileChangeStatus @default(PENDING)
  submittedByUserId   String?
  proposedName        String
  proposedEmail       String?
  proposedPhone       String?
  proposedWebsite     String?
  proposedLocation    String?
  proposedDescription String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  proposedLogoUrl     String?
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([organizationId, status])
}

model Category {
  id            String        @id @default(cuid())
  nameEn        String
  nameAr        String?
  slug          String        @unique
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  opportunities Opportunity[]
}

model Opportunity {
  id                     String                  @id @default(cuid())
  /// * Optional public slug for SEO URLs; falls back to `id` when absent.
  slug                   String?                 @unique
  title                  String
  description            String
  requirements           String?
  howToApply             String?
  externalApplyUrl       String?
  applyMode              OpportunityApplyMode    @default(INTERNAL)
  applicationEmail       String?
  externalApplicationUrl String?
  location               String?
  deadline               DateTime?
  type                   String
  workArrangement        WorkArrangement         @default(ONSITE)
  compensation           CompensationType        @default(PAID)
  status                 OpportunityStatus       @default(PENDING_APPROVAL)
  publishedAt            DateTime?
  closedAt               DateTime?
  organizationId         String
  categoryId             String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  applications           Application[]
  featured               FeaturedOpportunity?
  notifications          Notification[]
  category               Category?               @relation(fields: [categoryId], references: [id])
  organization           Organization            @relation(fields: [organizationId], references: [id])
  attachments            OpportunityAttachment[]
  savedBy                SavedOpportunity[]

  @@index([status, deadline])
  @@index([organizationId])
  @@index([categoryId])
}

model OpportunityAttachment {
  id            String      @id @default(cuid())
  opportunityId String
  fileName      String
  fileUrl       String
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

model Application {
  id                String            @id @default(cuid())
  opportunityId     String
  userId            String
  status            ApplicationStatus @default(SUBMITTED)
  coverLetter       String?
  applicantFullName String?
  applicantPhone    String?
  linkedinUrl       String?
  portfolioUrl      String?
  cvUrl             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  opportunity       Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, userId])
  @@index([userId, status])
  @@index([opportunityId, status])
}

model SavedOpportunity {
  id            String      @id @default(cuid())
  opportunityId String
  userId        String
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, userId])
  @@index([userId])
}

model Notification {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  opportunityId  String?
  title          String
  message        String
  href           String?
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  opportunity    Opportunity?  @relation(fields: [opportunityId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId])
  @@index([opportunityId])
}

model FeaturedOpportunity {
  id            String      @id @default(cuid())
  opportunityId String      @unique
  rank          Int         @default(0)
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([rank])
}

model ExternalApplyIntent {
  id             String               @id @default(cuid())
  listingId      String
  applicantEmail String
  channel        ExternalApplyChannel
  createdAt      DateTime             @default(now())

  @@unique([listingId, applicantEmail, channel])
  @@index([listingId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdminActionLog {
  id          String          @id @default(cuid())
  action      AdminActionType
  actorUserId String?
  targetType  String?
  targetId    String?
  meta        Json?
  createdAt   DateTime        @default(now())
  actorUser   User?           @relation("AdminActor", fields: [actorUserId], references: [id])

  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
}

/// * Public newsletter signups from the site (e.g. Resources page).
model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// * Homepage early-launch notify list (shown when published opportunity count is under 10).
model EarlyAccessEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// * Community events calendar (public events page).
model CommunityEvent {
  id        String   @id @default(cuid())
  eventDate String
  title     String
  detail    String
  href      String?
  confirmed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, eventDate])
}

/// * Key-value settings editable from admin (e.g. public contact card).
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum UserRole {
  INDIVIDUAL
  ORG_USER
  ADMIN
}

enum OrgVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  CURATED_PUBLIC_PROFILE
  UNCLAIMED_PROFILE
}

enum OpportunityStatus {
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  CLOSED
}

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

enum CompensationType {
  PAID
  UNPAID
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  ACCEPTED
}

enum OpportunityApplyMode {
  INTERNAL
  APPLY_BY_EMAIL
  EXTERNAL_LINK
}

enum ExternalApplyChannel {
  EMAIL
  EXTERNAL_LINK
}

enum AdminActionType {
  USER_CREATED
  USER_UPDATED
  USER_DISABLED
  ORG_APPROVED
  ORG_REJECTED
  OPPORTUNITY_APPROVED
  OPPORTUNITY_REJECTED
  OPPORTUNITY_EDITED
  OPPORTUNITY_REMOVED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  FEATURED_UPDATED
  CONTENT_REPORTED
  CONTENT_MODERATED
  REPORT_EXPORTED
  USER_REACTIVATED
  USER_DELETED
  ORGANIZATION_DEACTIVATED
  ORGANIZATION_REACTIVATED
  ORGANIZATION_DELETED
  OPPORTUNITY_DELETED
  ORG_PROFILE_CHANGE_APPROVED
  ORG_PROFILE_CHANGE_REJECTED
}

enum OrgProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrgClaimRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
